{
  "name": "@mcptoolshop/polyglot-mcp",
  "version": "1.10.1",
  "description": "Local GPU translation MCP server — TranslateGemma via Ollama, 57 languages, zero cloud dependency",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./translate": "./dist/translate.js",
    "./translateMarkdown": "./dist/translateMarkdown.js",
    "./codeSpans": "./dist/codeSpans.js",
    "./translateAll": "./dist/translateAll.js",
    "./validate": "./dist/validate.js",
    "./ollama": "./dist/ollama.js",
    "./languages": "./dist/languages.js",
    "./glossary": "./dist/glossary.js",
    "./polish": "./dist/polish.js",
    "./cache": "./dist/cache.js",
    "./semaphore": "./dist/semaphore.js",
    "./protectedTerms": "./dist/protectedTerms.js",
    "./survival": "./dist/survival.js",
    "./pins": "./dist/pins.js",
    "./pinCorrections": "./dist/pinCorrections.js"
  },
  "typesVersions": {
    "*": {
      "translate": [
        "./dist/translate.d.ts"
      ],
      "translateMarkdown": [
        "./dist/translateMarkdown.d.ts"
      ],
      "codeSpans": [
        "./dist/codeSpans.d.ts"
      ],
      "validate": [
        "./dist/validate.d.ts"
      ],
      "ollama": [
        "./dist/ollama.d.ts"
      ],
      "languages": [
        "./dist/languages.d.ts"
      ],
      "glossary": [
        "./dist/glossary.d.ts"
      ],
      "polish": [
        "./dist/polish.d.ts"
      ],
      "cache": [
        "./dist/cache.d.ts"
      ],
      "semaphore": [
        "./dist/semaphore.d.ts"
      ],
      "translateAll": [
        "./dist/translateAll.d.ts"
      ],
      "protectedTerms": [
        "./dist/protectedTerms.d.ts"
      ],
      "survival": [
        "./dist/survival.d.ts"
      ],
      "pins": [
        "./dist/pins.d.ts"
      ],
      "pinCorrections": [
        "./dist/pinCorrections.d.ts"
      ]
    }
  },
  "bin": {
    "polyglot-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "README.*.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/vitest/vitest.mjs run",
    "verify": "npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "translation",
    "ollama",
    "translategemma",
    "gpu",
    "local",
    "llm",
    "polyglot"
  ],
  "author": "MCP Tool Shop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-tool-shop-org/polyglot-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mcp-tool-shop-org/polyglot-mcp/issues"
  },
  "homepage": "https://github.com/mcp-tool-shop-org/polyglot-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "github-slugger": "2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "4.1.12",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
